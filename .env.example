# --- Required ---
GROQ_API_KEY=

# --- Groq models ---
GROQ_LLM_MODEL=qwen/qwen3.6-27b
GROQ_AGENT_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=autumn

# --- Speech ---
STT_PROMPT=XVF3800, XMOS, I2S, TDM, USB, reSpeaker, firmware, DSP, codec, GPIO, microcontroller, ESP32
STT_LANGUAGE=en

# --- reSpeaker Clip RTC live streaming (warm pause) ---
# Auto-arms one RTC session on connect; STOP stays terminal. While paused the
# device sends no BLE audio frames (mic pipeline stays warm).
RTC_AUTO_ARM=true
RTC_ARM_TIMEOUT=15
RTC_SETTLE_SECONDS=1.0
# Rolling partial STT: cumulative Ogg snapshots every RTC_PARTIAL_INTERVAL s,
# latest-wins, at most one request in flight per utterance. The final snapshot
# uses GROQ_RTC_FINAL_MODEL; utterances shorter than RTC_MIN_UTTERANCE_FRAMES
# never invoke the LLM.
GROQ_RTC_PARTIAL_MODEL=whisper-large-v3-turbo
GROQ_RTC_FINAL_MODEL=whisper-large-v3
RTC_PARTIAL_INTERVAL=2.0
RTC_PARTIAL_MIN_FRAMES=25
RTC_MIN_UTTERANCE_FRAMES=25
# Hard bounds: per-utterance frame cap, tentative first-frame pre-roll ring,
# and the FIFO of pending finalize jobs.
RTC_MAX_UTTERANCE_FRAMES=180000
RTC_PRE_ROLL_FRAMES=15
RTC_MAX_PENDING_FINALIZE=16

# --- Deployment scope ---
# false = device gateway: run the Clip runtime and its HTTP API only. The agent
# stack (LangGraph/Groq/Mem0/Pinecone) is never imported, no GROQ_API_KEY is
# needed, and each utterance / downloaded session is re-containerized to Ogg and
# served over HTTP instead of being transcribed and answered.
AGENT_ENABLED=true

# --- Storage (SQLite fallback if Supabase is empty) ---
DATABASE_URL=sqlite:///chat.db

# --- Tools ---
TAVILY_API_KEY=
# Financial Modeling Prep: market data for stocks, crypto, forex, commodities.
# Get a free key at https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
# Composio: external-app gateway (Gmail, Calendar, Slack, Linear, GitHub, ...).
# Empty COMPOSIO_API_KEY disables the gateway; the app keeps running with
# local tools only. COMPOSIO_TOOLKITS limits which toolkits are searchable.
COMPOSIO_API_KEY=
COMPOSIO_TOOLKITS=github
# Legacy direct SaaS modules below are retained but are not registered in the
# hybrid architecture. Active Gmail, Calendar, Slack, Linear, and Notion access
# is authenticated through Composio.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
# Legacy Slack bot/user tokens.
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
# Legacy Linear personal API key.
LINEAR_API_KEY=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_AGENT_PROFILE=https://shopify.dev/ucp/agent-profiles/examples/2026-04-08/valid-with-capabilities.json
# Order MCP: client credentials from the Dev Dashboard "Catalog" section.
# Required for shopify_get_order (read_global_api_orders scope).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- Long-term memory (Mem0) ---
MEM0_API_KEY=
MEM0_USER_ID=user-1

# --- Single-user id used across the system ---
USER_ID=user-1

# --- Supabase (optional; run supabase_schema.sql in the SQL Editor) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Pinecone (optional; conversation vector search) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=conversations
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Local embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- reSpeaker Clip input ---
# VOICE_INPUT_MODE=both (dev, manual Clip/browser) | clip (production, Clip only) | browser (legacy mic)
VOICE_INPUT_MODE=both
# Optional BLE address; omit to scan by CLIP_BLE_NAME
CLIP_BLE_ADDRESS=
CLIP_BLE_NAME=Clip
CLIP_RECORD_MODE=enhanced
CLIP_STATUS_INTERVAL=5
CLIP_DOWNLOAD_TIMEOUT=300
CLIP_TEMP_DIR=clip_audio
CLIP_MAX_FAILED_ARTIFACTS=5
